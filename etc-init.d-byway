#!/bin/sh /etc/rc.common
#
# Служба byway. Ставится в /etc/init.d/byway, права 0755.
#
# Порядок при старте важен и выбран так:
#   1. собрать конфиг, если его нет;
#   2. запустить Xray под присмотром procd;
#   3. дождаться, пока он ответит, и только тогда поднять обвязку.
#
# Именно в таком, а не наоборот. Обвязка уводит весь резолв роутера на
# DNS-вход Xray и ставит noresolv — значит поднять её раньше Xray означает
# оставить дом без DNS на всё время его запуска, а при сломанном конфиге
# и навсегда. Ожидание живёт в самом `byway plumb on`, чтобы защита работала
# при любом вызове, а не только из этого файла.
#
# Отсюда полезное следствие: если Xray не поднялся, обвязки просто не будет.
# Дом останется без туннеля, но с интернетом -- ЕСЛИ on_failure=open, а это
# умолчание. При closed доступ закрывается: в режиме списков -- к списку, в
# режиме «всё через VPN» -- весь выход наружу. podkop в этой ситуации уносил
# резолв с собой.
#
# При остановке порядок обратный: plumb off возвращает dnsmasq провайдеру
# ДО того, как procd убьёт Xray.

USE_PROCD=1
START=90
STOP=10

BYWAY=/usr/local/bin/byway
CONF=/etc/byway/config.json
# Слепок того, что РЕАЛЬНО применено: md5 конфига, с которым запущен движок, и
# md5 желаемого набора правил nft. Живёт в памяти, то есть до перезагрузки --
# после неё службу поднимает start и слепок пишется заново.
#
# Без него reload сравнивал файл сам с собой: панель после сохранения зовёт
# `byway gen` СВОИМ вызовом, и если он успевал раньше procd, то reload видел
# уже пересобранный файл, объявлял «конфиг не изменился» и службу не трогал.
# Настройки лежали в файле, движок работал по старым, панель писала
# «Применено». Слепок ломает эту ничью: сравнивается не файл с файлом, а файл
# с тем, что запущено.
STATE=/var/run/byway.applied

mark_applied() {
	{
		md5sum "$CONF" 2>/dev/null | cut -d' ' -f1
		"$BYWAY" nftsig 2>/dev/null | md5sum | cut -d' ' -f1
	} > "$STATE" 2>/dev/null || true
}
# Путь к бинарнику берётся из UCI тем же способом, что и в самом byway:
# так рядом живут пакетная версия из фида и поставленная вручную, а
# переключение и откат — одна команда uci. Без этого init-скрипт продолжал
# бы поднимать пакетную, сколько byway ни настраивай.
# Путь к движку приходит из UCI, а UCI правит панель -- значит это значение
# ПРИШЛО СНАРУЖИ, и исполнять по нему что попало от root нельзя. Ровно так
# устроены CVE в luci-app-travelmate и luci-app-samba4: бэкенд читает путь из
# конфигурации и запускает его. Валидатор в панели защитой не считается --
# в travelmate обошли именно его.
#
# Проверяем в таком порядке: сначала каталог (писать в системные может только
# root, так что это и есть граница доверия), потом исполняемость, и лишь потом
# спрашиваем версию -- запускать неизвестный файл ради проверки нельзя.
xray_ok() {
    case "$1" in
        /usr/bin/*|/usr/sbin/*|/usr/local/bin/*|/bin/*|/sbin/*) ;;
        *) return 1 ;;
    esac
    case "$1" in *..*) return 1 ;; esac
    [ -f "$1" ] && [ -x "$1" ] || return 1
    "$1" version 2>/dev/null | head -1 | grep -qi "^Xray " || return 1
}

XRAY=$(uci -q get byway.main.xray_bin || true)
if [ -n "$XRAY" ] && ! xray_ok "$XRAY"; then
    logger -t byway "путь к движку отклонён: $XRAY"
    XRAY=""
fi
[ -n "$XRAY" ] || XRAY=/usr/bin/xray

# Стоит ли обвязка сейчас. Нужно, чтобы не снимать то, чего не поднимали:
# `plumb off` безусловно зовёт dns_down, а тот безусловно перезапускает
# dnsmasq -- то есть на роутере, где byway ни разу не поднимался, отказ
# запуска дёргал резолвер всего дома. Таблица nft -- признак дешёвый и
# точный: её ставит и снимает только plumb.
# Живость движка -- по pid-файлу procd, а не по разбору вывода `ps`: его
# форма у busybox и у полноценного procps-ng разная, и на чужой прошивке
# reload считал исправный движок мёртвым.
byway_running() {
	_xp=$(cat /var/run/byway.pid 2>/dev/null)
	[ -n "$_xp" ] && [ -d "/proc/$_xp" ] && return 0
	ps w 2>/dev/null | grep -q "[r]un -c $CONF"
}

plumbed() {
    nft list table inet byway >/dev/null 2>&1
}

# Признак «start_service отказал». Нужен потому, что rc.common зовёт
# service_started независимо от того, чем кончился start_service: фоновый
# цикл из трёх попыток подъёма уходил работать даже тогда, когда причина
# отказа уже известна и напечатана. Каждая попытка ждала движок пятнадцать
# секунд и сама перезапускала dnsmasq -- на единственном шлюзе дома выходило
# четыре провала резолва за минуту на ровном месте.
FAILMARK=/var/run/byway-nostart

# ⚠️ Своя обёртка над restart. procd отвечает «Command failed: Not found»,
# когда останавливают службу, которой нет в его списке -- то есть при
# перезапуске уже остановленной. Это не ошибка, но выглядит ею ровно в тот
# момент, когда человек перезапускает после правки настроек, и он идёт искать
# несуществующую поломку. Поймано приёмкой владельца 2026-09-07.
#
# Глушим ТОЛЬКО стандартный поток ошибок остановки: свои сообщения
# stop_service пишет в stdout, они остаются на месте.
restart() {
	trap '' TERM
	stop "$@" 2>/dev/null
	start "$@"
}

start_service() {
	rm -f "$FAILMARK" 2>/dev/null || true
	# На обеих ветках отказа сначала снимаем обвязку, и только потом уходим.
	# Молчаливый return оставлял dnsmasq смотреть на порт, который никто не
	# слушает: выключение через `option enabled 0` роняло DNS всему дому.
	[ "$(uci -q get byway.main.enabled)" = "1" ] || {
		echo "byway выключен в /etc/config/byway (option enabled)"
		# --service, а не голый off: эта форма не ставит метку «сняли
		# руками», иначе сторож окажется заперт до перезагрузки.
		plumbed && "$BYWAY" plumb off --service
		: > "$FAILMARK"
		return 0
	}
	[ -x "$XRAY" ] || {
		echo "нет $XRAY — движок не найден"
		# Совет «поставить xray-core» на роутере, где движок уже лежит
		# рядом под своей версией, вёл ко второй копии ядра на разделе
		# 43.7 МБ, куда две не влезают. Сперва смотрим, нет ли готового.
		_alt=$(ls -1 /usr/local/bin/xray-* 2>/dev/null | tail -1)
		if [ -n "$_alt" ]; then
			echo "  рядом лежит $_alt"
			echo "  указать его: uci set byway.main.xray_bin=$_alt && uci commit byway"
		else
			echo "  поставить: apk update && apk add xray-core"
			echo "  либо указать свой путь: uci set byway.main.xray_bin=/путь/к/xray"
		fi
		plumbed && "$BYWAY" plumb off --service
		: > "$FAILMARK"
		return 1
	}

	# Проверяем конфиг, а не только его наличие. Пустой или битый файл
	# проходил проверку `[ -f ]`, Xray падал сразу, и дом оставался без DNS.
	if [ ! -f "$CONF" ] || ! "$XRAY" run -test -c "$CONF" >/dev/null 2>&1; then
		echo "конфиг отсутствует или отвергнут ядром — пересобираю"
		"$BYWAY" gen || {
			plumbed && "$BYWAY" plumb off --service
			: > "$FAILMARK"
			return 1
		}
	fi

	procd_open_instance byway
	procd_set_param command "$XRAY" run -c "$CONF"
	# Последний ноль — retry, и он означает «перезапускать без предела».
	# Было пять, и это оказалось опасно: procd считает не «пять падений за
	# час», а сбрасывает счётчик только после прогона длиннее часа. Шесть
	# падений, разнесённых хоть по полчаса, останавливали службу навсегда —
	# а вместе с ней дом оставался с резолвером, указывающим в мёртвый порт,
	# потому что stop_service при исчерпании respawn не вызывается.
	# Теперь DNS вернётся сам, как только Xray снова сможет подняться.
	procd_set_param respawn 3600 5 0
	# Xray пишет журнал в stdout, а не в stderr. Только stderr, как было
	# сначала, давал пустой logread при работающей службе — и диагностика
	# сводилась к гаданию.
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param pidfile /var/run/byway.pid
	procd_close_instance
}

service_started() {
	[ "$(uci -q get byway.main.enabled)" = "1" ] || return 0
	# start_service уже отказал и уже сказал человеку, почему. Три попытки
	# подъёма поверх этого ничего не изменят: движка нет, а каждая стоит
	# пятнадцати секунд ожидания и одного перезапуска dnsmasq.
	if [ -f "$FAILMARK" ]; then
		rm -f "$FAILMARK" 2>/dev/null || true
		return 0
	fi

	# plumb on сам ждёт ответа от Xray до пятнадцати секунд и при неудаче
	# не трогает ничего. Перезапуск dnsmasq внутри него заодно сбрасывает
	# кэш — а сбросить его обязательно: таблица соответствий fakedns живёт
	# в памяти Xray и перезапуск не переживает, поэтому выданные прошлым
	# запуском адреса из пула указывают в никуда.
	# Попытка не одна, и это не перестраховка. Одиночный вызов проваливался,
	# когда Xray в этот момент ещё поднимался -- тяжёлый конфиг, занятый
	# канал, холодный старт после перезагрузки, -- и туннеля не было до
	# ручного перезапуска. Снаружи это выглядело как «byway иногда просто не
	# работает после перезагрузки»: служба запущена, pid есть, обвязки нет.
	# Цикл уходит в ФОН, и это не украшение. Считая сон между попытками,
	# он держит start до минуты, а start держит restart. Панель ждёт ответа
	# около двадцати секунд и обрывает запрос: кнопка «Перезапустить»
	# отвечала «XHR request timed out» на исправном перезапуске, который в
	# это время спокойно шёл. В фоне start возвращается сразу, а попытки
	# продолжаются -- и остаются в системном журнале.
	(
		for _try in 1 2 3; do
			"$BYWAY" plumb on && exit 0
			[ "$_try" = 3 ] && break
			logger -t byway "обвязка не поднялась с попытки $_try, жду и пробую снова"
			sleep 10
		done
		logger -t byway "обвязка не поднялась за три попытки -- туннеля нет, интернет работает напрямую"
	) >/dev/null 2>&1 &
	# Номер фоновой подоболочки -- чтобы stop мог её убить. procd о ней не
	# знает: это не его инстанс, а отцепленный процесс, и он живёт до 65
	# секунд. Не убив его, получаем двух хозяев обвязки разом -- цикл
	# поднимает её, пока stop снимает.
	echo $! > /var/run/byway-plumb.pid 2>/dev/null || true

	# Слепок снимаем здесь, а не внутри фона: это запись «с какими настройками
	# служба поднята», а не «удалось ли». Не удалось -- поднимет сторож из
	# `byway watch`, настройки при этом те же самые.
	mark_applied
}

stop_service() {
	# Сперва убить фоновый цикл попыток, потом снимать. Иначе он продолжает
	# поднимать обвязку поверх снятой: замок в cmd_plumb не даст им идти
	# одновременно, но без этого kill порядок вышел бы обратный -- off
	# отработал бы первым, а цикл поднял бы всё назад при уже мёртвом движке.
	_pp=$(cat /var/run/byway-plumb.pid 2>/dev/null || true)
	if [ -n "$_pp" ]; then
		kill "$_pp" 2>/dev/null || true
		rm -f /var/run/byway-plumb.pid 2>/dev/null || true
	fi
	# --service, а не голый off: эта форма НЕ ставит метку «сняли руками».
	# С меткой выходило так -- служба остановилась, метка легла, у следующего
	# старта все три попытки подъёма провалились, и сторож оказался заперт до
	# перезагрузки ровно тогда, когда он и нужен.
	"$BYWAY" plumb off --service
}

reload_service() {
	# procd дёргает reload на КАЖДЫЙ `uci commit byway` -- в том числе когда
	# сменили язык панели или включили сбор статистики. Полный перезапуск на
	# такое рвёт все соединения на пятнадцать секунд, и панель показывает
	# красное на ровном месте: именно так выглядела «смена языка уронила
	# резолвер» 2026-09-04.
	#
	# Поэтому пересобираем конфиг и перезапускаем ТОЛЬКО если он изменился.
	# Сравнение по содержимому, а не по списку «важных» опций: список
	# пришлось бы держать в двух местах сразу и он разъезжался бы с кодом.
	# Живость проверяем через ps с разорванным шаблоном, а НЕ через pgrep -f:
	# pgrep находит сам себя -- его собственная командная строка содержит ту
	# же подстроку, -- и служба всегда выглядела запущенной. Из-за этого
	# включение галочкой не работало вовсе.
	#
	# Сначала выключатель, потом всё остальное. Опция enabled в конфиг Xray не
	# входит, поэтому сверка конфига её не замечала: галочка в панели ничего
	# не включала и не выключала до перезагрузки, а описание рядом обещало
	# обратное.
	if [ "$(uci -q get byway.main.enabled)" = "1" ]; then
		if ! byway_running; then
			logger -t byway "reload: включено -- запускаю"
			start
			return 0
		fi
	else
		if byway_running; then
			logger -t byway "reload: выключено -- останавливаю"
			stop
		fi
		return 0
	fi

	local have_conf have_nft want_conf want_nft
	have_conf=$(sed -n 1p "$STATE" 2>/dev/null)
	have_nft=$(sed -n 2p "$STATE" 2>/dev/null)

	if ! "$BYWAY" gen >/dev/null 2>&1; then
		logger -t byway "reload: конфиг не собрался, работает прежний"
		return 0
	fi
	want_conf=$(md5sum "$CONF" 2>/dev/null | cut -d' ' -f1)
	want_nft=$("$BYWAY" nftsig 2>/dev/null | md5sum | cut -d' ' -f1)

	# Пустой слепок -- значит служба поднята версией до этой правки либо
	# память чистили. Перезапускаем: лишний перезапуск дешевле молчаливого
	# расхождения, и он ровно один -- дальше слепок есть.
	if [ -z "$have_conf" ] || [ "$have_conf" != "$want_conf" ]; then
		logger -t byway "reload: конфиг изменился, перезапуск"
		stop
		start
		return 0
	fi

	# Часть настроек в конфиг движка не попадает вовсе: список интерфейсов и
	# метка живут только в правилах nft и в ip rule. По одному md5 конфига они
	# всегда выглядели «ничего не изменилось» -- гости добавлены в настройках,
	# в панели галочка стоит, а правило в ядре прежнее, и туннеля у них нет
	# до ручного `byway plumb on`. Перекладываем правила, движок не трогаем:
	# рвать соединения ради смены списка интерфейсов незачем.
	if [ "$have_nft" != "$want_nft" ]; then
		logger -t byway "reload: изменилась обвязка, перекладываю правила"
		# Слепок -- только после успеха. Стоя безусловно, он записывал
		# ЖЕЛАЕМУЮ обвязку как применённую: следующий reload с теми же
		# настройками уходил на «конфиг не изменился» и правила не
		# перекладывал, хотя в ядре их так и не было.
		if "$BYWAY" plumb on >/dev/null 2>&1; then
			mark_applied
		else
			logger -t byway "reload: обвязка не легла -- туннеля нет, интернет работает"
		fi
		return 0
	fi

	logger -t byway "reload: конфиг не изменился, служба не тронута"
}

service_triggers() {
	procd_add_reload_trigger byway
}
