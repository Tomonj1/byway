{
	"luci-app-byway": {
		"description": "Управление туннелем byway",
		"read": {
			"file": {
				"/etc/byway/domains.lst": [ "read" ],
				"/etc/byway/subnets.lst": [ "read" ],
				"/etc/byway/presets/*": [ "read" ],
				"/etc/byway/routes/*": [ "read" ]
			},
			"uci": [ "byway" ],
			"ubus": {
				"luci": [ "getInitList" ],
				"service": [ "list" ]
			}
		},
		"write": {
			"cgi-io": [ "exec" ],
			"file": {
				"/etc/byway/domains.lst": [ "write" ],
				"/etc/byway/subnets.lst": [ "write" ],
				"/etc/byway/routes/*": [ "read", "write" ],
				"/etc/byway/usage.tsv": [ "read" ],
				"/etc/byway/health.log": [ "read" ],
				"/tmp/byway-import.txt": [ "write" ],
				"/usr/local/bin/byway": [ "exec" ],
				"/etc/init.d/byway": [ "exec" ]
			},
			"uci": [ "byway" ],
			"ubus": {
				"luci": [ "setInitAction" ]
			}
		}
	}
}
